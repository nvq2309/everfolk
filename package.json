{
  "name": "everfolk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Everfolk \u2014 a storybook life simulator set on Egypt's ancient Mediterranean coast.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "demo": "node examples/play.ts",
    "dev": "node scripts/run-framework.mjs dev",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/run-framework.mjs build",
    "preview": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "content": "node scripts/build-alexandria-world.mjs",
    "db:generate": "drizzle-kit generate",
    "ranked:world": "node scripts/ranked/build-ranked-world.mjs"
  },
  "packageManager": "pnpm@11.25.0",
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "next": "16.3.4",
    "drizzle-orm": "0.45.2",
    "@near-wallet-selector/core": "10.1.4",
    "@near-wallet-selector/meteor-wallet": "10.1.4",
    "@near-wallet-selector/modal-ui": "10.1.4",
    "@near-wallet-selector/my-near-wallet": "10.1.4",
    "buffer": "6.0.3",
    "near-api-js": "7.4.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "wrangler": "4.92.0",
    "drizzle-kit": "0.31.10",
    "typescript": "^5.9.3",
    "vite": "8.0.13"
  }
}
